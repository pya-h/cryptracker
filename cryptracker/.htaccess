# The cryptracker/ folder holds all backend code, secrets (.env), the database,
# and tests. It is meant to live OUTSIDE the web document root (a sibling of
# public/). This file is defense-in-depth: if this folder is ever exposed under
# a served path due to a docroot misconfiguration, deny every request so source,
# secrets and stored data can never be browsed or downloaded.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and earlier
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Never list directory contents, regardless of the above.
Options -Indexes
