# Public document root for CrypTracker.
# cPanel deployment: map the CONTENTS of this folder to public_html, and keep
# ../cryptracker (backend, .env, database, tests) OUTSIDE the web root.

# Disable directory browsing so no folder (assets, etc.) can be listed.
Options -Indexes

# Block direct access to hidden/sensitive files if any ever land here.
<FilesMatch "^\.(env|git|htaccess)|\.(env|ini|log|sql|sqlite|db|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
