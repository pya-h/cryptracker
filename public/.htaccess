# Public document root for CrypTracker.
# cPanel deployment: map the CONTENTS of this folder to public_html, and keep
# ../cryptracker (backend, .env, database, tests) OUTSIDE the web root.

# Disable directory browsing so no folder (assets, etc.) can be listed.
Options -Indexes

# Block direct access to hidden/sensitive files if any ever land here.
<FilesMatch "^\.(env|git|htaccess)|\.(env|ini|log|sql|sqlite|db|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- PWA support ---
# Serve the web app manifest with the correct MIME type.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Keep the service worker fresh so app updates roll out promptly, and allow it
# to control the whole origin.
<Files "service-worker.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </IfModule>
</Files>
